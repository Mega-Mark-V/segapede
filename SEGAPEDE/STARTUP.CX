#pragma dsection .text

#pragma interrupt VBLHandler

void VBLHandler(){
  tickCounter++;
  vblFlag= 1;
  DoIO();
}

#pragma interrupt HBLHandler

void HBLHandler(){
  asm(" and.w #$f0ff,(sp)",4);
  asm(" or.w #$0500,(sp)",4);
}

#pragma interrupt ErrorHandler
#pragma no_return ErrorHandler

void ErrorHandler(){
  while(1);
}


void WaitTOF(){
  vblFlag= 0;
  do {
    asm(" stop #$2500",4);
  } while(!vblFlag);
}


void ReadHWControllers(){
  asm(" move.w  #$2700,SR",4);
  gemsholdz80();
  asm(" lea $a10003,a0");

  asm(" move.b #0,(a0)");
  asm(" nop");
  asm(" nop");
  asm(" move.b (a0),d0");
  asm(" lsl.b #2,d0");
  asm(" andi.b #$c0,d0");

  asm(" move.b #$40,(a0)");
  asm(" nop");
  asm(" nop");
  asm(" move.b (a0),d1");
  asm(" andi.b #$3f,d1");
  asm(" or.b d1,d0");
  asm(" not.b d0");


  asm(" move.b d0,_bStick1");
  asm(" lea $a10005,a0");

  asm(" move.b #0,(a0)");
  asm(" nop");
  asm(" nop");
  asm(" move.b (a0),d0");
  asm(" lsl.b #2,d0");
  asm(" andi.b #$c0,d0");

  asm(" move.b #$40,(a0)");
  asm(" nop");
  asm(" nop");
  asm(" move.b (a0),d1");
  asm(" andi.b #$3f,d1");
  asm(" or.b d1,d0");
  asm(" not.b d0");


  asm(" move.b d0,_CurrentStick2");
  asm(" move.w #$2000,SR");
  gemsreleasez80();

  StickEdges1= (CurrentStick1^LastStick1)&CurrentStick1;
  LastStick1= CurrentStick1;
  StickEdges2= (CurrentStick2^LastStick2)&CurrentStick2;
  LastStick2= CurrentStick2;
}


void SegaLogo(){
short *palette;
int i,j;

  SendBlock32(logoData,FG_CELLS+32,1600);
  palette= AllocMem(128);
  for(i= logoColors[0];i<logoColors[1];i++){
    palette[i]= logoColors[i+2];
  }
  SendBlock32(logoMap,LOGO1,24);
  SendBlock32(logoMap+12,LOGO2,24);
  SendBlock32(logoMap+24,LOGO3,24);
  SendBlock32(logoMap+36,LOGO4,24);
  WaitTOF();
  FadeIn(palette,45);
  for(i= 0;i<31;i++)
    WaitTOF();
  for(i= 20;i>0;i--){
    for(j= 0;j<11;j++){
      palette[2+j]= logoColors[4+i+j];
    }
    SendPalettes(palette);
    WaitTOF();
    WaitTOF();
    WaitTOF();
    WaitTOF();
  }
  for(i= 0;i<27;i++)
    WaitTOF();
  FadeOut(palette,45);
  FreeMem(palette);
}

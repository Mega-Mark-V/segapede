#
#       This is the make file for the Segapede demo
#
#       Opus Make, Sierra C
#

#.MISER_MODE disk		# MDT: Commented out, had issues in DOSBOX

DRV=      c:
ROOT=     $(DRV)\segapede
CDIR=     $(ROOT)\c
INCDIR=   $(ROOT)\inc
ASMDIR=   $(ROOT)\asm
OBJDIR=   $(ROOT)\obj

ARTDRV=   c:			# MDT: Directed to a directory on C drive to make setup simpler
ARTROOT=  $(ARTDRV)\spart	# MDT: Directed to a directory on C drive to make setup simpler
ARTDIR=   $(ARTROOT)\art
SPRDIR=   $(ARTROOT)\sprite
ANIMDIR=  $(ARTROOT)\anim

TMPDIR=   c:\temp\		# MDT: Directed to a directory on C drive to make setup simpler

SNOBOL= c:\snobol\snobol4

SIERRA= $(DRV)\sierra\bin
CC=     $(SIERRA)\com68
COPTS=  -I$(INCDIR) -Q -fC3 -l -OAa2f0l4p1r2x1 -g1

%if 0
LIST=   -p80 -w132
%else
LIST=   -l
%endif

ASM=    $(SIERRA)\asm68
ASMOPTS=$(LIST) -Q -k


.PATH.c=$(CDIR)
.PATH.h=$(INCDIR)
.PATH.s=$(ASMDIR)
.PATH.i=$(ASMDIR)
.PATH.o=$(OBJDIR)
.PATH.asm=$(ASMDIR)
.PATH.dgt=$(ARTDIR)
.PATH.spr=$(SPRDIR)
.PATH.anm=$(ANIMDIR)


OBJ=    \
        anim.o \
        defs.o \
        defs2.o \
        draw.o \
        gems.o \
        io.o \
        logo.o \
        math.o \
        player.o \
        screen.o \
        segapede.o \
        segments.o \
        startup.o \
        title.o \
        utils.o \
        vectors.o



ART=    zipart.h zipart2.h zipsegs.h

.c.o:
        *$(CC) $(CDIR)\$[r,$*].c $(TMPDIR)\$[r,$*].s $(COPTS) >> err 2>>&1
        *$(ASM) $(ASMOPTS) $(TMPDIR)\$[r,$*].s -o$(OBJDIR)\$[r,$*].o
        del $(TMPDIR)\$[r,$*].s

.s.o:
        *$(ASM) $(ASMOPTS) $(ASMDIR)\$[r,$*].s -o$(OBJDIR)\$[r,$*].o

.c.s:
        *$(CC) $(CDIR)\$[r,$*].c $(ASMDIR)\$[r,$*].s $(COPTS)

.asm.o:
        *$(ASM)k $(ASMOPTS) $(ASMDIR)\$[r,$*].asm -o$(OBJDIR)\$[r,$*].o

.spr.h:
        -81 *cmmje <<<
3011010
%foreach x in $(.SOURCES)
%if $[r,$(x)] != $[r,$(.TARGET)]
l $(ARTDIR)\$[r,$(x)].dgt
ms $(TMPDIR)\$[r,$(x)].map
c$[r,$(x)]
%endif
%end
s $(TMPDIR)\$[r,$(.TARGET)].cel
$[r,$(.TARGET)]
q
<   >> err 2>>&1
        copy $(SPRDIR)\$[r,$(.TARGET)].spr $(TMPDIR)\$[r,$(.TARGET)].z
        %foreach x in $(.SOURCES)
        %if $[r,$(x)] != $[r,$(.TARGET)]
        type $(TMPDIR)\$[r,$(x)].map >> $(TMPDIR)\$[r,$(.TARGET)].z
        %endif
        %end
        del $(TMPDIR)\*.map
        *$(SNOBOL) < <

        &TRIM = 1
READ1   LINE = INPUT                :F(END)
        LINE POS(0) ';'             :S(READ1)
        OUTPUT = 'global unsigned short ' LINE '[]'
        OUTPUT = CHAR(35) 'ifdef DEFINE_GLOBALS'
        OUTPUT = ' = {'
READ2   LINE = INPUT                :F(DONE)
        LINE 'dc.w    ' = ''
AGAIN   LINE CHAR(36) = '0x'        :S(AGAIN)
        OUTPUT = LINE ','           :(READ2)
DONE    OUTPUT = '}'
        OUTPUT = CHAR(35) 'endif'
        OUTPUT = ';'
END

< /I=$(TMPDIR)\$[r,$(.TARGET)].cel /O=$(TMPDIR)\$[r,$(.TARGET)].xxx
        del $(TMPDIR)\$[r,$(.TARGET)].cel
        type $(TMPDIR)\$[r,$(.TARGET)].xxx >> $(TMPDIR)\$[r,$(.TARGET)].z
        del $(TMPDIR)\$[r,$(.TARGET)].xxx
        *$(SNOBOL) < <

        &TRIM = 1
        FNAME = '0123456789_' &LCASE
        NUMS = '0123456789,'
        NAMEPAT = BREAK(FNAME) SPAN(FNAME) . NAME
        CGPAT = BREAK(NUMS) SPAN(NUMS) . CG
        CONTACTPAT = BREAK(NUMS) SPAN(NUMS) . CONTACT
        ENTRIES = TABLE()
        CENTRIES = TABLE()
SET     LINE = INPUT
        OUTPUT = LINE
        LINE POS(0) 'OFFSETS'              :F(SET)
LOAD    LINE = REPLACE(INPUT, &UCASE, &LCASE)
        OUTPUT = LINE
        LINE NAMEPAT =                      :F(FIX)
        LINE CGPAT =
        LINE CONTACTPAT =
        ENTRIES[NAME] = CG
        CENTRIES[NAME] = CONTACT            :(LOAD)
FIX     LINE = INPUT                        :F(END)
        OUTPUT = LINE
        LINE 'Map table'                    :F(FIX)
        OUTPUT = INPUT
        OUTPUT = INPUT
        LINE = INPUT
        OUTPUT = LINE
        LINE 'global unsigned short ' NAMEPAT
        OUTPUT = INPUT
        OUTPUT = INPUT
        OUTPUT = INPUT
        LINE = INPUT
        LINE '0x00,0x00' = ENTRIES[NAME]
        OUTPUT = LINE
        LINE ENTRIES[NAME] = CENTRIES[NAME]
        OUTPUT = LINE                       :(FIX)
END

< /I=$(TMPDIR)\$[r,$(.TARGET)].z /O=$(INCDIR)\$[r,$(.TARGET)].h
        del $(TMPDIR)\$[r,$(.TARGET)].z

.anm.h:
        del $(TMPDIR)\foo.foo
        %foreach x in $(.SOURCES)
        %if $[r,$(x)] != $[r,$(.TARGET)]
        type $(x) >> $(TMPDIR)\foo.foo
        %endif
        %end
        *$(SNOBOL) < <
        &TRIM = 1
        FNAME = '0123456789_' &LCASE &UCASE
        NUMS = '0123456789'
        NAMEPAT = BREAK(FNAME) SPAN(FNAME) . NAME
        NUMPAT = BREAK(NUMS) SPAN(NUMS) . NUM
        STARTPOINTS = TABLE()
        LINECOUNT = 0
        OUTPUT = 'global AnimState animations[]'
        OUTPUT = CHAR(35) 'ifdef DEFINE_GLOBALS'
        OUTPUT = ' = {'
LOOK    LINE = INPUT                                    :F(DONE)
        LINE POS(0) 'ANIMATION' NAMEPAT                 :F(LOOK)
        GROUPNAME = NAME
        STARTPOINTS[GROUPNAME] = LINECOUNT
*  Get the next script line
        LINE = INPUT                                    :F(ERROR)
AGAIN   LINECOUNT = LINECOUNT + 1
*  Pick off the line number
        LINE NUMPAT =                                   :F(ERROR)
        LINENO = NUM
*   Pick off the frame name
        LINE NAMEPAT =                                  :F(ERROR)
        FRAMENAME = NAME
*   Pick off the frame art set
        LINE NAMEPAT =                                  :F(ERROR)
        ARTSETNAME = NAME
*   Pick off the duration
        LINE NUMPAT =                                   :F(ERROR)
        TIME = NUM
*   Eat up any spaces
CLIP    LINE ' ' =                                      :S(CLIP)
*   If the 'next' field starts with a colon, it's a reference to another sequence
        LINE ':' =                                      :S(NAMED)
        LINE NUMPAT =
        NEXTLINE = NUM + STARTPOINTS[GROUPNAME] - 1     :(WRITE)
NAMED   LINE NAMEPAT =                                  :F(ERROR)
        NEXTLINE = STARTPOINTS[NAME]                    :F(ERROR)
        LINE '[' =                                      :F(WRITE)
        LINE NUMPAT                                     :F(ERROR)
        NEXTLINE = NEXTLINE + NUM - 1
WRITE   OUTPUT = '{' FRAMENAME ',' TIME ',' NEXTLINE ',' ARTSETNAME '},'
        LINE = INPUT                                    :F(ERROR)
        LINE 'END'                                      :F(AGAIN) S(LOOK)
DONE    OUTPUT = '}'
        OUTPUT = CHAR(35) 'endif'
        OUTPUT = ';'
        A = CONVERT(STARTPOINTS,"ARRAY")                :F(ERROR)
LOOP    OUTPUT = CHAR(35) 'define ANIM_' A[N,1] ' ' A[N,2]
        N = N + 1
        DIFFER(A[N,1])                                  :S(LOOP) F(END)
ERROR   SCREEN = 'Malformed input'
        &CODE = 10
END

< /I=$(TMPDIR)\foo.foo /O=$(TMPDIR)\foo.bar
        del $(TMPDIR)\foo.foo
        copy $(ANIMDIR)\$[r,$(.TARGET)].anm+$(TMPDIR)\foo.bar $(INCDIR)\$[r,$(.TARGET)].h
        del $(TMPDIR)\foo.bar

all:    segapede loadall

art:    $(ART)

rom:    segapede.out
        *$(SIERRA)\sldr -S -t segapede.out segapede.s
        *s2bin segapede.s segapede.bin

#loadall:
#        segaload segapede.out
#loadall:
#        *$(SIERRA)\sldr -S -t segapede.out segapede.s
#        *s2bin segapede.s segapede.bin
loadall:
        *erx68k loadngo
        segaload segapede.out


segapede: segapede.out

segapede.out: $(OBJ)
        *$(SIERRA)\link68 -i < <
$**
-lc
-o $@
-m
-E
-P
MEMORY {
        vectorrom:  ORG(0)          LEN(0x000200)
        rom:        ORG(0x200)      LEN(0x0ffe00)
        ram:        ORG(0x00ff8000) LEN(0x008000)
}
SECTIONS {
        .vectors: {} > vectorrom
        .text:    {} > rom
        .data:    {} > rom
        .bss:     {} > ram
        .vdp: ORG(0xc00000) DSECT {}
}
<



